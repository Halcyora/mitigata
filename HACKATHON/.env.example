# Select one profile per scan; supported values: flask_demo, juice_shop
TARGET_PROFILE=flask_demo
TARGETS_ROOT=/targets

# Azure OpenAI — GPT-4o primary, GPT-4o-mini fallback
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-4o-mini

# Leave blank to disable the LLM layer and use deterministic template patches only.
# AZURE_OPENAI_KEY=
