# Select one profile per scan; supported values: flask_demo, juice_shop
TARGET_PROFILE=flask_demo
TARGETS_ROOT=/targets

# Sarvam Token Factory — OpenAI-compatible API
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_MODEL=glm5.3

# Leave blank to disable the LLM layer and use deterministic template patches only.
# SARVAM_API_KEY=
